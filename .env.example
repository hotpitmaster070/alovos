# Copy to .env.local. Both Supabase values are required for login and registration.
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Used by invoice scanning and waste photo checks. Do not prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-openai-key

# Server-only. Waste photo AI checks (paid add-on): the service_role key records verdicts and counts
# checks so members cannot approve their own waste. Without it or the model, photos stay "not checked".
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
WASTE_AI_MODEL=gpt-4o-mini
# Optional: USD per 1M tokens, to store each check's cost in ai_analysis.cost_usd.
WASTE_AI_INPUT_USD_PER_1M=
WASTE_AI_OUTPUT_USD_PER_1M=

# Server-only. Auto-order scheduler: /api/cron/auto-order accepts "Authorization: Bearer <CRON_SECRET>".
# The alovos-auto-order cron job calls it when the Supabase Vault holds alovos_app_url and alovos_cron_secret.
CRON_SECRET=
# Server-only. Orders to suppliers over WhatsApp Cloud API (Meta): an approved template whose body has
# {{1}} = restaurant name, {{2}} = order lines, registered in az / ru / en. Without these, orders go by link.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
# Optional, default v21.0.
WHATSAPP_API_VERSION=
# Server-only. Orders to suppliers by email through Resend; RESEND_FROM must be on a verified domain.
RESEND_API_KEY=
RESEND_FROM=
